{
  "manifest_version": 3,
  "name": "OTP Bridge",
  "short_name": "OTP Bridge",
  "version": "1.0.0",
  "description": "Fills in verification codes sent to your phone with one click. Needs the OTP Bridge companion running on this computer.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OTP Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["mail.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://mail.google.com/*"],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "otp-bridge@otp-bridge.invalid",
      "strict_min_version": "121.0"
    }
  }
}
